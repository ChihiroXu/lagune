---
import "../../../design/styles/components.css";
import logo from "../../../design/brand/LAGUNE_logo.svg";

const areas = [
  {
    name: "CONFLUX",
    description: "Spatial intelligence and reproducible analysis.",
  },
  {
    name: "INSIGHTS",
    description: "Research questions, sources, methods, and provenance.",
  },
  {
    name: "DESIGN",
    description: "Visual language, cartography, and visualization standards.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="LAGUNE — Spatial Intelligence & Research." />
    <title>LAGUNE — Spatial Intelligence & Research</title>
  </head>
  <body>
    <main class="lagune-container lagune-section">
      <header class="intro-panel lagune-tidal-panel">
        <img class="brand-mark" src={logo.src} alt="LAGUNE" />
        <p class="eyebrow">Spatial Intelligence &amp; Research</p>
        <h1 class="lagune-heading lagune-heading--display">LAGUNE</h1>
        <p class="intro lagune-copy">
          A research platform for investigating spatial questions and communicating evidence with
          documented methods, attributable sources, and contextual interpretation.
        </p>
      </header>
      <section class="research-section" aria-labelledby="areas-heading">
        <h2 id="areas-heading" class="lagune-heading lagune-heading--section">Research platform</h2>
        <ul class="lagune-grid lagune-grid--research">
          {areas.map((area) => (
            <li class="lagune-card">
              <div class="lagune-card__body">
                <h3 class="lagune-heading">{area.name}</h3>
                <p class="lagune-copy">{area.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>

<style>
  .intro-panel {
    padding: clamp(1.5rem, 5vw, 4rem);
  }

  .brand-mark {
    width: 5rem;
    height: auto;
  }

  .eyebrow {
    color: var(--lagune-ocean);
    font-size: var(--lagune-text-sm);
    font-weight: 600;
    text-transform: uppercase;
  }

  .intro {
    font-size: var(--lagune-text-lg);
  }

  .research-section {
    margin-top: var(--lagune-space-16);
  }

  .research-section h2 {
    margin-bottom: var(--lagune-space-6);
  }

  .lagune-grid {
    padding: 0;
    list-style: none;
  }

  .lagune-card h3 {
    font-size: var(--lagune-text-lg);
  }

  .lagune-card p {
    margin-bottom: 0;
  }
</style>
