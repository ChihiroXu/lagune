---
const areas = [
  {
    name: "CONFLUX",
    description: "Spatial intelligence and reproducible analysis.",
  },
  {
    name: "INSIGHTS",
    description: "Research questions, sources, methods, and provenance.",
  },
  {
    name: "DESIGN",
    description: "Visual language, cartography, and visualization standards.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="LAGUNE — Spatial Intelligence & Research." />
    <title>LAGUNE — Spatial Intelligence & Research</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">Spatial Intelligence &amp; Research</p>
      <h1>LAGUNE</h1>
      <p class="intro">
        A research platform for investigating spatial questions and communicating evidence with
        documented methods, attributable sources, and contextual interpretation.
      </p>
      <section aria-labelledby="areas-heading">
        <h2 id="areas-heading">Research platform</h2>
        <ul>
          {areas.map((area) => (
            <li>
              <h3>{area.name}</h3>
              <p>{area.description}</p>
            </li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color: #172a2a;
    background: #f5f7f4;
    font-family: "Segoe UI", sans-serif;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }

  body {
    margin: 0;
  }

  main {
    box-sizing: border-box;
    margin: 0 auto;
    max-width: 64rem;
    padding: clamp(2rem, 8vw, 6rem) 1.5rem;
  }

  .eyebrow {
    color: #45635e;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(3rem, 10vw, 6rem);
    letter-spacing: 0.04em;
    margin: 1rem 0;
  }

  .intro {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    line-height: 1.6;
    max-width: 48rem;
  }

  section {
    margin-top: 4rem;
  }

  ul {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    list-style: none;
    padding: 0;
  }

  li {
    border-top: 2px solid #45635e;
    padding-top: 0.75rem;
  }
</style>
